# Copy this file to `.env` and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the app (via import.meta.env.VITE_*).
# NOTE: every VITE_ var is PUBLIC — it gets embedded in the built JS bundle.
# Never put a true server-side secret here.

# Contact form (Web3Forms) — used by src/pages/contact/apiConfig.js
VITE_API_ENDPOINT=https://api.web3forms.com/submit
VITE_ACCESS_KEY=your-web3forms-access-key

# reCAPTCHA (work-in-progress, src/recaptchaConfig.js)
# Only the SITE key belongs on the frontend; the SECRET key must stay server-side.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
